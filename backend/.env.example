# ==============================================================================
# EduVerse Local Backend Development Configuration
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="EduVerse"
API_V1_PREFIX=/api/v1

SECRET_KEY=dev-secret-key-change-me-for-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./data/eduverse.db
DATA_DIR=./data

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://[::1]:4200

# Gmail instructor enrollment notifications. Use a Google App Password, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

HOST=127.0.0.1
PORT=8000
RELOAD=true

AI_PROVIDER=local_fallback
