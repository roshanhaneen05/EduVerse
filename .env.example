# ==============================================================================
# EduVerse Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# NEVER commit the real .env file or sensitive production secrets to source control.
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="EduVerse"
API_V1_PREFIX=/api/v1

# Security & JWT Configuration
# Generate a strong key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-for-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite for local development, PostgreSQL for production)
# Local SQLite default:
DATABASE_URL=sqlite:///./data/eduverse.db
# PostgreSQL Example (Future Azure/Production migration):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/eduverse

# Persistent Local Application Data Directory
DATA_DIR=./data

# CORS Allowed Origins (Comma-separated or JSON list for frontend)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Server Binding
HOST=127.0.0.1
PORT=8000
RELOAD=true

# AI Provider Configuration (Default is local deterministic fallback provider)
AI_PROVIDER=local_fallback
# Real AI Provider Settings (Optional for future integration)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

